APP_NAME=Nebula API
APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

LOG_LEVEL=debug

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nebula
POSTGRES_USER=nebula
POSTGRES_PASSWORD=nebula
POSTGRES_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

# ------------------------
# Xray
# ------------------------

XRAY_ENABLED=false
XRAY_BASE_URL=http://localhost:8081
XRAY_API_KEY=
XRAY_TIMEOUT=15s

XRAY_BINARY=C:\xray\xray.exe
XRAY_CONFIG=C:\xray\config.json
XRAY_WORKDIR=C:\xray
# Xray

XRAY_ENABLED=true

XRAY_BINARY_PATH=./bin/xray.exe

XRAY_CONFIG_PATH=./storage/xray/config.json

XRAY_WORKING_DIR=./storage/xray

XRAY_API_ADDRESS=127.0.0.1

XRAY_API_PORT=10085
